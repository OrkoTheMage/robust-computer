# ─────────────────────────────────────────────────────────────────────────────
# Robust Computer — Environmental Variables (Contract / Template)
# ─────────────────────────────────────────────────────────────────────────────
# This is the canonical contract for `.env.dev` and `.env.prod`. Copy to one of
# those files and fill in real values. `scripts/dev.js` selects `.env.dev` or
# `.env.prod` based on `--env=dev|prod` (which also sets the server's `NODE_ENV`).
# Both Vite apps (`landing/`, `portal/`) read the same file via `envDir: '../'`.
# ─────────────────────────────────────────────────────────────────────────────


# ═══════════════════════════════════════════════════════════════════════════
# Server (Express + MongoDB) — read by server/src/config.js
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=
MONGODB_URI=
JWT_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
LANDING_URL=
API_URL=


# ═══════════════════════════════════════════════════════════════════════════
# landing (React + Vite) — read by landing/src/config.js
# ═══════════════════════════════════════════════════════════════════════════

VITE_API_URL=
VITE_LANDING_URL=
