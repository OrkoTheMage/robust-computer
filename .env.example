# ─────────────────────────────────────────────────────────────────────────────
# Robust Computer — Environmental Variables (Contract / Template)
# ─────────────────────────────────────────────────────────────────────────────
# This is the canonical contract for `.env.dev` and `.env.prod`. Copy to one of
# those files and fill in real values. `scripts/dev.js` selects `.env.dev` or
# `.env.prod` based on `--env=dev|prod` (which also sets the server's `NODE_ENV`)
# Vite app (`landing/`) read the same file via `envDir: '../'`.
# ─────────────────────────────────────────────────────────────────────────────


# ═══════════════════════════════════════════════════════════════════════════
# Server (Express + MongoDB) — read by server/src/config.js
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=
MONGODB_URI=
LANDING_URL=
API_URL=
PORT=
NEWSLETTER_ADMIN_SECRET=

# Email (SMTP for development)
# Set only for development (ignored in production)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Mailpit (dev only, optional)
# `scripts/mailpit.js` reads SMTP_PORT (default 1025) and
# MAILPIT_HTTP_PORT (default 8025). `scripts/smoke-server.mjs`
# reads the same two ports when probing the local catcher.
# Leave both unset to use the Mailpit defaults; set them
# only when running Mailpit on a non-default port.
MAILPIT_HTTP_PORT=

# Email (Resend HTTPS API for production) + DKIM signing
# Set only for production (ignored in development)
RESEND_API_KEY=
DKIM_DOMAIN=
DKIM_KEY_SELECTOR=
DKIM_PRIVATE_KEY=



# ═══════════════════════════════════════════════════════════════════════════
# landing (React + Vite) — read by landing/src/config.js
# ═══════════════════════════════════════════════════════════════════════════

VITE_API_URL=
VITE_LANDING_URL=
