# ── Server (read by server/src/config.js) ──────────────────────────────
NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/robust_computer
JWT_SECRET=replace-me-with-a-long-random-string

# SMTP — Mailpit default for local dev (set SMTP_SECURE=true for real SMTP)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Robust Computer <hello@robustcomputer.example>"

# Public URLs (used by the server for cross-app links + email)
LANDING_URL=http://localhost:3000
API_URL=http://localhost:5000

# ── Landing (read by landing/src/config.js, Vite-prefixed) ─────────────
VITE_API_URL=http://localhost:5000
VITE_LANDING_URL=http://localhost:3000
