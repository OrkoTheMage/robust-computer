# ── dependencies ─────────────────────────────────────────────────────────
node_modules/
.yarn/
.pnp.*

# ── env (never commit real secrets) ─────────────────────────────────────
.env
.env.*
!.env.example

# ── destructive dev tools
**/reset-db.mjs

# ── build output ────────────────────────────────────────────────────────
**/dist/
**/.next/
**/.cache/

# ── logs ────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── editor / OS ─────────────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/
*.swp

# ── scratch / temp ──────────────────────────────────────────────────────
# `*.txt` is broad on purpose: catches any stray notes/checklists
*.txt

# ── .txt Whitelist
!landing/public/robots.txt
!landing/public/feed.txt
!landing/public/latest.txt

# ── project documentation ─────────────────────────────────────────────────
PROJECT-CONVENTIONS.md
FIELD-NOTES-SYNTAX.md

# ── downloaded Mailpit binary (used by `yarn mail`) ────────────────────
scripts/.mailpit/

# ── root lockfile (convention: each sub-project tracks its own) ────────
# /landing/yarn.lock  → tracked
# /server/yarn.lock   → tracked
/yarn.lock

# ── vercel ──────────────────────────────────────────────────────────────
.vercel/

# ── runtime ─────────────────────────────────────────────────────────────
*.pid
.tmp/

# ── smoke test temp files (written to landing/ at runtime, deleted in finally) ──
landing/.smoke-entry.mjs
landing/.smoke-bundle.mjs
