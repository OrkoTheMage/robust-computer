# ── dependencies ─────────────────────────────────────────────────────────
node_modules/
.yarn/
.pnp.*

# ── env (never commit real secrets) ─────────────────────────────────────
.env
.env.*
!.env.example

# ── destructive dev tools (safety net even if the file doesn't exist yet)
**/reset-db.mjs

# ── build output ────────────────────────────────────────────────────────
**/dist/
**/.next/
**/.cache/

# ── logs ────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── editor / OS ─────────────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/
*.swp

# ── scratch / temp ──────────────────────────────────────────────────────
# `*.txt` is broad on purpose: catches any stray notes/checklists dropped
# at the repo root. Whitelist the one .txt the app actually ships.
*.txt
!landing/public/robots.txt

# ── downloaded Mailpit binary (used by `yarn mail`) ────────────────────
scripts/.mailpit/

# ── root lockfile (convention: each sub-project tracks its own) ────────
# /landing/yarn.lock  → tracked
# /server/yarn.lock   → tracked
/yarn.lock

# ── vercel ──────────────────────────────────────────────────────────────
.vercel/

# ── runtime ─────────────────────────────────────────────────────────────
*.pid
.tmp/
